# Copy this file to .env, then add your own API key.
# Get a key from the OpenAI API dashboard. ChatGPT Plus and API billing are separate.
OPENAI_API_KEY=replace_with_your_api_key
OPENAI_MODEL=gpt-6-astra
# Optional: set a model that your API project is allowed to use.
# OPENAI_MODEL=gpt-5.4
# Optional: use a compatible OpenAI API base URL only if you know why you need it.
# OPENAI_BASE_URL=https://api.openai.com/v1
PORT=4173
